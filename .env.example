# ============================================================
# ASK AI VIDEO STUDIO — example configuration
# Copy to `.env` (never committed) and replace every CHANGE_ME.
# NEVER put real values in this file.
# ============================================================

# development | production
NODE_ENV=production

# Network binding. 127.0.0.1 = only this machine (recommended behind a reverse proxy).
# Use 0.0.0.0 only on a trusted LAN if you need direct mobile access.
HOST=127.0.0.1
PORT=4310

# Absolute path OUTSIDE the git checkout. Holds database, media, logs, backups,
# browser profiles. Created with 0700 permissions on first start.
PRIVATE_STORAGE_ROOT=/private/runtime/path

# Long random string (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=CHANGE_ME

# Optional. Defaults to <PRIVATE_STORAGE_ROOT>/database/studio.sqlite
# DATABASE_PATH=/private/runtime/path/database/studio.sqlite

# Set true when served over HTTPS (required for production internet exposure).
COOKIE_SECURE=true

# Set true ONLY when behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false

# Upload limit in megabytes.
MAX_UPLOAD_MB=25

# Login attempts allowed per client IP per 15 minutes.
LOGIN_IP_LIMIT=20

# embedded = worker runs inside the web process; external = run `npm run worker` separately.
WORKER_MODE=embedded

# Optional tool locations (auto-detected on PATH if unset).
# FFMPEG_PATH=/usr/bin/ffmpeg
# CHROME_PATH=/usr/bin/chromium

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Production Google Flow automation stays DISABLED until the Flow Feasibility Lab
# has been validated manually. Do not change this in Phase 1.
FLOW_AUTOMATION_ENABLED=false
